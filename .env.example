# Copy to .env.local for `vercel dev`, or paste into
# Vercel → Project → Settings → Environment Variables.
# .env / .env.local are git-ignored. Never commit real values.

# ---------- AI (existing) ----------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---------- Twilio Voice (browser calling) ----------
# Console → Account Info
TWILIO_ACCOUNT_SID=AC...
# Console → Account → API keys & tokens → Create API key (Standard)
TWILIO_API_KEY_SID=SK...
TWILIO_API_KEY_SECRET=
# Console → Voice → TwiML → TwiML Apps → create one, set its
# Voice Request URL to https://<your-app>.vercel.app/api/twilio-voice (POST)
TWILIO_TWIML_APP_SID=AP...
# The Twilio number you bought — used as the outbound caller ID
TWILIO_CALLER_ID=+1...

# ---------- Trial-account safety ----------
# A trial account ONLY connects numbers verified in the Console
# (Phone Numbers → Verified Caller IDs). Mirror that list here and the
# UI warns before dialing instead of failing mid-demo. Comma-separated.
TWILIO_ALLOWED_NUMBERS=

# ---------- Optional ----------
# Prefix bare local numbers with this country code (e.g. 66 for Thailand)
TWILIO_DEFAULT_COUNTRY_CODE=
# Ring time in seconds before giving up
TWILIO_DIAL_TIMEOUT=30
# "true" to record calls. OFF by default — recording without consent is
# illegal in most jurisdictions (TH PDPA, India, EU GDPR).
TWILIO_RECORD=false
# Only for /api/twilio-call (server-initiated fallback)
TWILIO_AGENT_PHONE=
TWILIO_PUBLIC_URL=
# Full-access token — only needed if you skip the API key above
TWILIO_AUTH_TOKEN=
